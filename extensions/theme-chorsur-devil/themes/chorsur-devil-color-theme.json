		"breadcrumb.activeSelectionForeground": "#FF2222",

		"focusBorder": "#FF222266",
		"foreground": "#E0E0E0",
		"widget.shadow": "#00000066",
		"selection.background": "#FF222244",
		"descriptionForeground": "#888888",
		"errorForeground": "#FF4444",
		"icon.foreground": "#FF4444"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#555555",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#FF4444"
			}
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": {
				"foreground": "#FF8800"
			}
		},
		{
			"scope": ["keyword", "keyword.control", "keyword.operator", "storage.type", "storage.modifier"],
			"settings": {
				"foreground": "#FF0044",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": {
				"foreground": "#00FF88"
			}
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": {
				"foreground": "#00DDAA"
			}
		},
		{
			"scope": ["variable", "variable.other", "variable.parameter"],
			"settings": {
				"foreground": "#E0E0E0"
			}
		},
		{
			"scope": ["variable.language", "variable.other.constant"],
			"settings": {
				"foreground": "#FF6644"
			}
		},
		{
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": {
				"foreground": "#FF2222"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#00FF66",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["support.constant", "constant.other"],
			"settings": {
				"foreground": "#FFAA22"
			}
		},
		{
			"scope": ["meta.decorator", "punctuation.decorator"],
			"settings": {
				"foreground": "#FF44AA"
			}
		},
		{
			"scope": ["punctuation", "meta.brace"],
			"settings": {
				"foreground": "#888888"
			}
		},
		{
			"scope": ["markup.heading"],
			"settings": {
				"foreground": "#FF2222",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#FF6644"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#00FF88"
			}
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": {
				"foreground": "#FF8800"
			}
		},
		{
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#4488FF"
			}
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#FF0000",
				"fontStyle": "underline"
			}
		}
	]
}