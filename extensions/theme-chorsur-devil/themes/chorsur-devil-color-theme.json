		"notifications.background": "#111111",
		"notifications.border": "#330000",

		"gitDecoration.addedResourceForeground": "#00FF66",
		"gitDecoration.modifiedResourceForeground": "#FF8800",
		"gitDecoration.deletedResourceForeground": "#FF2222",
